# The audit log is a transport, not a record.  Nothing reads it after the worker has, and on a busy
# share it grows fast, so it is rotated aggressively and kept briefly.
#
# `copytruncate` rather than `create`, deliberately: rsyslog holds the file open, and rotating by
# rename without telling it leaves it writing to an unlinked inode until the next restart.  The
# reader handles both — it notices a changed inode AND a size that went backwards — but the one
# that keeps rsyslog working without a signal is this one.
#
# `tools/install/install.sh` installs this file — it is not a manual step, and for a while it was
# neither: the rule sat in the repository while no installation path ever copied it, so the log on
# a real box grew without a bound until the system disk filled.  `su root depsis-api` needs the
# depsis-api group to exist, which is why the installer copies it after creating the accounts.

/var/log/depsis/smb-audit.log {
    hourly
    rotate 4
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su root depsis-api
}
