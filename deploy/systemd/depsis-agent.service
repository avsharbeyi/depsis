# The DEPSIS system agent.
#
# It runs as root and ADR-0006 does not pretend otherwise: `zpool` operations cannot be
# delegated, and CAP_SYS_ADMIN is root-equivalent, so an ambient-capability set here would buy
# the appearance of least privilege and none of the substance. Safety comes from the surface
# being small — a closed typed operation enum, peer-credential authorization, and an audit
# entry for every call — not from this file.
#
# What this file DOES buy is the hardening that costs nothing and the hardening that would cost
# correctness, kept apart and labelled. Every directive below is exercised by P0-E; a hardening
# directive that is never tested against the real workload is a directive that gets removed in
# a panic at 3am when something inexplicably fails.

[Unit]
Description=DEPSIS system agent
Documentation=file:///usr/share/doc/depsis/adr/0006-system-agent.md

# In [Unit], not [Service]. systemd logs "Unknown key ... ignoring" for these in
# [Service] and starts the unit anyway, so the rate limiting they describe is simply absent
# — measured: both units carried them in the wrong section and neither was in effect.
StartLimitBurst=5
StartLimitIntervalSec=60
# BOTH sockets. The agent refuses to start with only one of them, and it is right to: with only
# the control socket the API would mint transfer tokens and stage files for data connections that
# can never arrive, so every upload would fail after a five-minute timeout and look like a network
# fault rather than a missing unit.
Requires=depsis-agent.socket depsis-agent-data.socket
After=depsis-agent.socket depsis-agent-data.socket zfs.target

[Service]
# Type=exec, not simple: systemd then considers the unit started only once execve has actually
# succeeded, so a missing binary or a bad interpreter fails the start job instead of being
# reported as a success followed by a mysterious exit.
Type=exec
ExecStart=/usr/local/lib/depsis/depsis-agent --serve

# The uid the API runs as. Read from the environment, never inferred: looking a username up at
# runtime would mean a rename or a uid reuse silently changed who may drive privileged
# operations. The installer writes this drop-in; the agent refuses to start without it, and
# refuses uid 0.
EnvironmentFile=/etc/depsis/agent.env

# Socket-activated and long-lived. Restart on failure, but rate-limited: a crash loop on a root
# daemon that shells out to zfs should stop and be noticed, not retry forever.
Restart=on-failure
RestartSec=2s

# ─── the ceilings the code assumes ────────────────────────────────────────────
# Both numbers exist because the agent's own limits are meaningless without them.
#
# MAX_PENDING_TRANSFERS is 64 open descriptors held by a root daemon, plus MAX_DATA_CONNECTIONS
# (16) live connections, plus two listeners, the control connection, the pipes of whatever `zfs`
# child is running, and stdio. 1024 leaves room for all of it several times over while still being
# a limit — the inherited default is 524288, which is not a bound so much as the absence of one.
LimitNOFILE=1024

# 16 data workers, the control thread, and the processes the agent execs. TasksMax bounds the
# blast radius if a future change ever spawns per connection instead of using the pool; without it
# that regression would look like nothing at all until the box ran out of pids.
TasksMax=64

# ─── hardening that is free here ──────────────────────────────────────────────
# "Free" means measured, not assumed. P0-E timed every directive below against
# `readlink /proc/self/ns/mnt` on systemd 257 and kept only the ones that leave the service in
# pid 1's mount namespace. An earlier version of this file asserted the same thing from reading
# the documentation and was wrong about two of them — see the block after this one.

# The agent must never gain privileges it did not start with. It runs as root, so this is not
# about the agent itself — it is about the four binaries it execs. A setuid binary appearing on
# the box cannot become a privilege escalation path through this service.
NoNewPrivileges=yes

# LOOPBACK VE YALNIZ LOOPBACK. İlk hâli her IP ailesini yasaklıyordu ("ajan ağa hiç ulaşmaz"),
# ve ilk gerçek kurulum bunun ZeroTier controller'ıyla çeliştiğini buldu: zerotier-one'ın yerel
# API'si 127.0.0.1:9993'te — başka arayüzü yok — ve ajan ona ulaşamayınca her uzaktan-erişim
# işlemi "ZeroTier yok" diye yanıtlandı. İzin tam olarak döngü arayüzü kadar açıldı:
# IPAddressDeny=any duruyor, yalnız localhost delik. Dışarıya sızdırma koruması aynen yerinde —
# root bir daemon'a HTTP istemcisi ekleyen gelecekteki bir değişiklik, internete yine buradan
# değil ancak bilinçli bir birim düzenlemesiyle çıkabilir.
# AF_NETLINK de sahada ödendi: pdbedit dahil her Samba aracı smb.conf'u yüklerken ağ
# arayüzlerini NETLİNK ile sayar; soket açılamayınca "Could not determine network interfaces"
# der ve kimlik eşitleme (SMB parolaları) hiç çalışmaz. Netlink internete çıkış değil, çekirdeğe
# "hangi arayüzler var" sorusudur — IPAddressDeny bu yüzden onu zaten kapsamıyor.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
IPAddressDeny=any
IPAddressAllow=localhost

RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

# RestrictSUIDSGID=yes is DELIBERATELY ABSENT, and this is the most expensive line in the file.
#
# It blocks openat2(2) outright. systemd implements the directive with a seccomp filter on the mode
# argument of every file-creating syscall; for openat2 the mode lives inside a `struct open_how` in
# userspace memory, which seccomp cannot dereference, so it denies the call rather than risk letting
# a setuid file through. openat2(RESOLVE_BENEATH) is the ENTIRE containment mechanism for anything
# written into a share (ADR-0017), so with this directive on, every upload fails.
#
# Measured, not read: P1-D reported "path escapes the share root: alice/.depsis/staging/probe.part"
# for a path that escapes nothing, and finding the cause took a directive-by-directive bisection of
# this file. Both halves of that have been fixed — the agent now names ENOSYS for what it is, and
# refuses to start at all if openat2 is unavailable rather than failing every transfer individually.
#
# What is given up, and why it is affordable: the directive stops a process CREATING setuid or
# setgid files. This agent creates files in exactly one place, with a fixed mode of 0600 built from
# an `OpenIntent`, and the caller cannot express a mode at all — there is no operand for it anywhere
# in the request enum. NoNewPrivileges=yes above still prevents any setuid binary being USED to gain
# privilege through this service. The residual risk is a future change that adds a caller-supplied
# mode, which is a code review away, not a seccomp filter away.


# Measured safe: neither of these puts the service in its own mount namespace.
ProtectClock=yes
ProtectHostname=yes

# What ProtectKernelModules= and ProtectKernelLogs= would have bought, bought a different way.
#
# Those two directives look like pure capability removal and are not: both make paths
# inaccessible (/proc/kmsg, /dev/kmsg, the module tree), which puts the service in a private
# mount namespace. P0-E measured the consequence rather than the directive — a dataset created
# through the agent was mounted where only the agent could see it, while the agent returned
# `created` and `zfs list` on the host showed the dataset existing. Samba would have served an
# empty directory with no error anywhere.
#
# Subtracting the capabilities directly, and filtering the module syscalls with seccomp, gets the
# same restriction with no namespace at all. The `~` form of SystemCallFilter= is a deny list, so
# it does not impose an allow list and cannot break mount(2) the way @system-service would.
CapabilityBoundingSet=~CAP_SYS_MODULE CAP_SYSLOG CAP_SYS_TIME CAP_WAKE_ALARM
SystemCallFilter=~@module

# ─── off-site replication's own state ─────────────────────────────────────────
#
# The agent keeps an SSH identity and a `known_hosts` under /var/lib/depsis/offsite, creating the
# directory on first use. No StateDirectory= here, and that is not an oversight: StateDirectory=
# creates the path under a private mount namespace, which is the same trap the section below
# describes for every other namespacing directive — the directory would exist for this service and
# for nothing else. The agent runs as root with no ProtectSystem=, so an ordinary mkdir is both
# sufficient and visible from outside.
#
# THE PRIVATE KEY LIVES THERE, mode 0600. Two consequences worth writing down for whoever sets a
# machine up: a backup of /var/lib that leaves the appliance carries a credential which can write
# to the off-site destination, and restoring an appliance from an image restores that credential
# with it. Neither is a reason to keep the key somewhere else — anywhere the agent can read it, an
# image of the disk can too — but both are reasons to treat that directory as secret.
#
# Requires: openssh-client (ssh, ssh-keygen, ssh-keyscan), at the absolute paths in dispatch.rs.

# ─── the appliance's own database ─────────────────────────────────────────────
#
# ZFS snapshots protect the user's FILES. What they do not protect is who those files belong to:
# accounts, share definitions, folder grants, the task board and the file index all live in
# PostgreSQL, and PostgreSQL lives on the system disk. Lose that disk and every byte on the pool
# survives with nothing left to say who may read it.
#
# DEPSIS_BACKUP_DATABASE_URL — what `pg_dump` connects to. UNSET BY DEFAULT and the operation then
# refuses with a sentence saying so, rather than defaulting to `postgres://localhost/depsis`:
# dumping the wrong database and reporting "you have a backup" is worse than having none. Use the
# `depsis_backup` role, which migration 0001 grants SELECT and nothing else.
#
# DEPSIS_DB_BACKUP_DIR — where the dumps go; /var/lib/depsis/db-backups by default. NOT a share,
# and that is a security decision rather than a choice of location: the dump carries password
# hashes, sealed TOTP secrets and SMB NT hashes, so a share would hand all of them to anybody with
# `download` on it. Files are written 0600 with the mode set BEFORE any bytes.
#
# Getting them OFF the box is the administrator's own step: create a backup schedule for the
# dataset that directory lives on, or copy the files. A dump that never leaves the appliance does
# not survive the appliance.
#
# Requires: postgresql-client (pg_dump), at the absolute path in dispatch.rs.

# ─── hardening deliberately NOT enabled, with reasons ─────────────────────────
#
# ProtectSystem=, ProtectHome=, PrivateTmp=, ReadWritePaths=, ProtectProc=, PrivateDevices=,
# ProtectKernelModules=, ProtectKernelLogs=
#   Every one of these puts the service in a private mount namespace — measured, one directive
#   at a time, in P0-E section 3a. systemd sets that namespace's propagation to slave, so mounts
#   made INSIDE it do not propagate out. `zfs create` mounts the new dataset there and nowhere
#   else. The dataset exists, the agent reports success, `zfs list` on the host shows it, and
#   Samba serves an empty directory. No error is produced at any layer.
#
#   MountFlags=shared would make the mounts propagate out, and is refused because it propagates
#   in the other direction too: the inaccessible-path bind mounts those directives create would
#   then land on the host, making /dev/kmsg or /dev/rtc unusable system-wide. Trading a silent
#   share failure for a silent host failure is not an improvement.
#
#   P0-E asserts the observable consequence directly: a dataset created through the agent must
#   be visible in /proc/1/mountinfo, not merely in the agent's own view.
#
# PrivateDevices= additionally would hide /dev/sd* and break smartctl, which needs SG_IO on the
#   real block device.
#
# No ReadWritePaths= for /etc/samba either, and it is worth saying why rather than leaving the
#   next reader to wonder. The agent writes /etc/samba/depsis.conf — atomically, via a temp file
#   and a rename in that directory — and the obvious hardening would be ProtectSystem=strict with
#   ReadWritePaths=/etc/samba. That pair is exactly the private-mount-namespace trap above: it
#   would leave `zfs create` mounting datasets where nothing else can see them, and Samba serving
#   empty directories with no error anywhere. There is no ProtectSystem= here, so /etc/samba is
#   already writable; the narrowing would cost the product its storage and buy a root daemon
#   almost nothing.
#
# SystemCallFilter= in its ALLOW-LIST form (e.g. =@system-service)
#   @system-service excludes @mount, and `zfs create` calls mount(2). The filter is inherited by
#   every child process, so a filter tight enough to be worth having is a filter that breaks the
#   agent's primary operation, and one widened to @mount @privileged @raw-io buys little against
#   a root process. Only the deny-list form is used above, which adds no allow list and so
#   cannot have this effect.

# ─── audit ────────────────────────────────────────────────────────────────────
# The agent writes one JSON object per audit entry to stderr; systemd routes it to the journal.
# No journald library in a root process, and `journalctl -u depsis-agent -o cat` reads it on a
# box with nothing else installed.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=depsis-agent

[Install]
# Deliberately absent: WantedBy=multi-user.target. The unit is started by its socket, on demand.
# Enabling it directly would start a root daemon at boot whether or not the API exists.
