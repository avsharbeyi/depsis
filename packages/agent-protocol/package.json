{
  "name": "@depsis/agent-protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "build": "tsc -b tsconfig.build.json && node -e \"const fs=require('node:fs');fs.mkdirSync('dist/generated',{recursive:true});fs.copyFileSync('src/generated/agent.d.ts','dist/generated/agent.d.ts');\"",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
