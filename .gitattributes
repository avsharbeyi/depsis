# DEPSIS line-ending policy
#
# We author on Windows but ship to Debian. A CRLF that reaches a shell script,
# a systemd unit, a preseed file or a cloud-init seed produces failures that are
# extremely hard to diagnose (e.g. `#!/bin/bash\r: bad interpreter`).
# Therefore: LF is the default in the repository AND in the working tree.

* text=auto eol=lf

# Must be LF — consumed by Linux
*.sh            text eol=lf
*.bash          text eol=lf
*.service       text eol=lf
*.socket        text eol=lf
*.timer         text eol=lf
*.conf          text eol=lf
*.cfg           text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.sql           text eol=lf
*.rs            text eol=lf
*.toml          text eol=lf
Makefile        text eol=lf
Dockerfile      text eol=lf
*.preseed       text eol=lf
user-data       text eol=lf
meta-data       text eol=lf

# Must be CRLF — consumed by Windows tooling
*.ps1           text eol=crlf
*.psm1          text eol=crlf
*.psd1          text eol=crlf
*.cmd           text eol=crlf
*.bat           text eol=crlf

# Binary — never diff, never normalise
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.webp          binary
*.woff          binary
*.woff2         binary
*.pdf           binary
*.vhd           binary
*.vhdx          binary
*.iso           binary
*.qcow2         binary
*.raw           binary
*.img           binary
*.tar           binary
*.gz            binary
*.xz            binary
*.zst           binary

# Generated — collapse in diffs and reviews
pnpm-lock.yaml  linguist-generated=true -diff
Cargo.lock      linguist-generated=true -diff
