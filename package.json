{
  "name": "depsis",
  "version": "0.0.0",
  "private": true,
  "description": "DEPSIS — Debian tabanlı çok kullanıcılı NAS ve özel sunucu platformu",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.19.0",
    "pnpm": ">=11.21.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test:unit": "turbo run test:unit",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "lint": "turbo run lint",
    "lint:workflows": "bash tools/ci/workflow-gate.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm lint:workflows && pnpm typecheck && pnpm generate:check && pnpm test:unit",
    "generate": "turbo run generate",
    "generate:check": "turbo run generate:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "turbo": "2.10.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
